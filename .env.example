# Reference list of the environment variables rated-mcp reads.
# The server does NOT load .env files. Put the API key in your OS keychain or
# shell environment instead (see README). Placeholders only; never commit real values.

RATED_API_KEY=your-rated-api-key-here

# Optional (defaults shown)
RATED_ENABLE_WRITES=false
RATED_DEFAULT_PAGE_SIZE=5
RATED_MAX_PAGE_SIZE=50
RATED_MAX_RETRIES=3
RATED_MAX_RETRY_WAIT=30
RATED_MIN_REQUEST_INTERVAL=0.5
RATED_TIMEOUT=60
RATED_MAX_RESPONSE_CHARS=60000
RATED_SKIP_KEY_CHECK=false
